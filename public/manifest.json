{
    "id": "/app/",
    "name": "Mapleby Staff",
    "short_name": "Mapleby",
    "description": "Mapleby staff app: cars, containers, documents and money, each role sees its own screens.",
    "start_url": "/app/dashboard?source=pwa",
    "scope": "/app/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "portrait",
    "background_color": "#FAF7F2",
    "theme_color": "#171819",
    "icons": [
        { "src": "/images/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/images/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/images/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Add car", "url": "/app/operations/shipments?create=true", "icons": [{ "src": "/images/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "Containers", "url": "/app/operations/containers", "icons": [{ "src": "/images/icons/icon-192.png", "sizes": "192x192" }] }
    ]
}
